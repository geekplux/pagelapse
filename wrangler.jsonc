// Pagelapse: one Worker + Static Assets. Static files (including sample pictures) never invoke the Worker;
// only /api/* does. This file is PRODUCTION only (no named environments) plus the `previews` block for Workers
// Builds branch previews. Workers Builds runs `pnpm run build`, then `npx wrangler deploy`. `pnpm dev` uses
// wrangler.local.jsonc (no AI, local KV). Deploying: docs/DEPLOY.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagelapse",
  "main": "worker/index.ts",
  // The newest date the pinned workerd (via @cloudflare/vite-plugin's Miniflare) supports; refresh with upgrades.
  "compatibility_date": "2026-10-12",
  // Served at https://pagelapse.geekplux.com (and the workers.dev host); no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  // Custom domain, also attached in the dashboard: declaring it here keeps `wrangler deploy` from removing it.
  "routes": [{ "pattern": "pagelapse.geekplux.com", "custom_domain": true }],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Run /api/* next to the Internet Archive rather than next to each visitor: nearly every uncached request goes there.
  // An experiment too: the archive refuses the Worker's usual egress for hours (docs/DEPLOY.md, Logs), and a different
  // data center may leave from different addresses. Static assets are still served from the nearest location.
  "placement": { "hostname": "web.archive.org" },
  // Workers Logs: request logs and `console.error` from API errors, sampled at 100%.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Workers AI: one-line change summaries. No key or secret; without it the app writes rule summaries.
  "ai": { "binding": "AI" },
  // KV `CACHE`: the namespace titled PAGELAPSE_CACHE (docs/DEPLOY.md, step 3). Not a secret.
  "kv_namespaces": [{ "binding": "CACHE", "id": "d1881ba046b74f8bbd26b6d7164f555f" }],
  // Per-IP limits on uncached upstream fetches and summary batches. namespace_id is account-wide and Workers that
  // share one share counters; sibling projects use 1xxx-4xxx and 6xxx, so Pagelapse uses 5xxx.
  "ratelimits": [
    { "name": "UPSTREAM_LIMIT", "namespace_id": "5001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "5002", "simple": { "limit": 10, "period": 60 } },
    { "name": "GALLERY_LIMIT", "namespace_id": "5003", "simple": { "limit": 3, "period": 60 } }
  ],
  // Workers Builds branch previews (`npx wrangler preview`) do not inherit the bindings above. Previews get their
  // own rate-limit counters, but no CACHE (the Worker falls back to a small in-memory cache) and no AI (the daily AI
  // cap is counted in KV, so previews write rule summaries). They never touch production KV.
  "previews": {
    "ratelimits": [
      { "name": "UPSTREAM_LIMIT", "namespace_id": "5101", "simple": { "limit": 20, "period": 60 } },
      { "name": "AI_LIMIT", "namespace_id": "5102", "simple": { "limit": 10, "period": 60 } },
      { "name": "GALLERY_LIMIT", "namespace_id": "5103", "simple": { "limit": 3, "period": 60 } }
    ]
  }
}
