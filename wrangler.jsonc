// Pagelapse: one Worker + Static Assets (D1). Static files (including sample pictures) never invoke the Worker;
// only /api/* does. Deploying is phase 19 and needs Sean's approval; the KV id is set then.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagelapse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "CACHE", "id": "<set-at-deploy>" }],
  "ratelimits": [{ "name": "UPSTREAM_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
