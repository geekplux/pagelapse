// Local only: `pnpm dev` reads this file (vite.config.ts); `pnpm preview` serves the production build with remote bindings off.
// Same Worker as wrangler.jsonc minus the AI binding (Workers AI always reaches Cloudflare and needs a login) and the
// custom domain, so local runs work offline. KV is simulated locally (Miniflare), so its id is a dummy.
// Kept out of wrangler.jsonc so `wrangler deploy` there sees one environment and prints no warning.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagelapse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "UPSTREAM_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
